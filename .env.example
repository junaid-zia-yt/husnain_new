# Required for production. Never commit your real .env file.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=your-project.vercel.app
DASHBOARD_USERNAME=REPLACE_WITH_USERNAME
DASHBOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Realtime Firebase telemetry source (not a Django SQL database).
FIREBASE_DATABASE_URL=https://health-monitor-iot-ce814-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PATIENT_PATH=patient
FIREBASE_ECG_PATH=ecg_live
FIREBASE_TIMEOUT_SECONDS=8
POLL_INTERVAL_MS=1000
ENABLE_SSE=False

# Leave blank if Firebase rules allow public reads. In production, use
# restricted Firebase rules and configure ONE of the following:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_AUTH_TOKEN=
